# Copy to .env and adjust. All values are optional.

# HTTP/MCP/WebSocket server
CUTLINE_HOST=127.0.0.1
CUTLINE_PORT=4100

# Where projects, uploaded media, exports and analysis caches are stored
CUTLINE_DATA_DIR=./.cutline-data

# Require "Authorization: Bearer <token>" on every request (set this for any non-local deployment)
# CUTLINE_TOKEN=

# Extra hostnames allowed in the Host header (comma separated), e.g. when behind a reverse proxy
# CUTLINE_ALLOWED_HOSTS=editor.example.com

# Directories add_asset may read local files from (separator: ; on Windows, : elsewhere). Default: home dir + data dir
# CUTLINE_MEDIA_ROOTS=

# Allow add_asset to download from private/loopback network addresses
# CUTLINE_ALLOW_PRIVATE_URLS=0

# Explicit ffmpeg/ffprobe binaries (default: looked up on PATH)
# FFMPEG_PATH=
# FFPROBE_PATH=

# Speech-to-text model for get_transcript (Hugging Face id, ONNX weights, downloaded on first use)
# CUTLINE_WHISPER_MODEL=onnx-community/whisper-base_timestamped

# Public URL of the editor, used in tool results ("open the editor at ...")
# CUTLINE_PUBLIC_URL=http://localhost:5173

# Where downloaded speech-to-text models are cached (default: inside node_modules)
# CUTLINE_MODEL_DIR=
