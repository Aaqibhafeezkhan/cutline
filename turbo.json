{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["FFMPEG_PATH", "FFPROBE_PATH", "CUTLINE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs:tools": {
      "cache": false
    }
  }
}
